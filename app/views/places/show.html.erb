<p><a href="/places">All places</a></p>
<h1><%= @place["name"] %></h1>

<% if @entries.empty? %>
  <p>No entries yet.</p>
<% else %>
  <ul>
    <% @entries.each do |entry| %>
      <li>
        <h2><%= entry["title"] %></h2>
        <p><%= entry["occurred_on"] %></p>
        <p><%= entry["description"] %></p>
      </li>
    <% end %>
  </ul>
<% end %>
